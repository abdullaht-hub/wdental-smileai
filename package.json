{
  "name": "wdental-smile-preview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:exif": "node scripts/check-exif-stripped.ts",
    "check:token": "node --conditions=react-server scripts/check-job-token.ts",
    "check": "npm run typecheck && npm run check:exif && npm run check:token",
    "check:creds": "node --env-file=.env.local scripts/check-credentials.ts",
    "blobs": "node --conditions=react-server --env-file=.env.local scripts/check-blob-empty.ts",
    "smoke": "node --env-file=.env.local scripts/preview-smoke.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^0.27.0",
    "google-auth-library": "^9.15.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
